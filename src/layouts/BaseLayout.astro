---
import "../styles/global.css";
import NavBar from "../components/NavBar.svelte";
import { ClientRouter } from "astro:transitions";

export interface Props {
    title: string;
    description?: string;
}

const { title, description = "Asandei Stefan-Alexandru" } = Astro.props;
const currentYear = new Date().getFullYear();
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={description} />
        <script is:inline>
            // Apply the saved theme before first paint to avoid a flash.
            // Defaults to light.
            (function () {
                var stored = null;
                try {
                    stored = localStorage.getItem("theme");
                } catch (_) {}
                if (
                    stored === "dark" ||
                    (!stored &&
                        window.matchMedia("(prefers-color-scheme: dark)")
                            .matches)
                ) {
                    document.documentElement.classList.add("dark");
                }
            })();
        </script>
        <!-- <ClientRouter /> -->
        <script>
            // Copy-to-clipboard for code blocks (event delegation, site-wide).
            document.addEventListener("click", async (event) => {
                if (!(event.target instanceof Element)) return;
                const button = event.target.closest("[data-copy-code]");
                if (!(button instanceof HTMLButtonElement)) return;
                const pre = button
                    .closest("[data-code-block]")
                    ?.querySelector("pre");
                if (!pre) return;

                const code = pre.innerText.replace(/\n+$/, "");
                try {
                    await navigator.clipboard.writeText(code);
                } catch (_) {
                    // fallback for older browsers
                    const ta = document.createElement("textarea");
                    ta.value = code;
                    document.body.appendChild(ta);
                    ta.select();
                    document.execCommand("copy");
                    ta.remove();
                }

                button.dataset.copied = "true";
                setTimeout(() => delete button.dataset.copied, 1500);
            });
        </script>
    </head>
    <body class="bg-background text-foreground">
        <NavBar client:load />

        <slot />

        <footer
            class="mt-6 py-6 border-t border-border text-sm text-muted-foreground"
        >
            <div
                class="md:max-w-2xl lg:max-w-6xl mx-2 md:mx-auto flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4"
            >
                <div>Copyright {currentYear} Asandei Stefan-Alexandru</div>

                <a href="#" class="hover:text-foreground transition-colors">
                    ↑ Back to top
                </a>
            </div>
        </footer>
    </body>
</html>
