---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionTitle from "../../components/SectionTitle.svelte";
import ArticleTimeline from "../../components/ArticleTimeline.svelte";

export async function getStaticPaths() {
    const blogEntries = await getCollection("blog");
    return blogEntries.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
    title={`${entry.data.title} - Asandei`}
    description={entry.data.description || entry.data.title}
>
    <main class="px-2 lg:px-0 lg:max-w-none flex flex-col gap-12">
        <article class="prose prose-invert max-w-none lg:max-w-6xl lg:mx-auto">
            <SectionTitle large={true}>{entry.data.title}</SectionTitle>

            <div class="text-muted-foreground text-sm mb-8">
                {
                    entry.data.date.toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                    })
                }
            </div>

            <div
                class="prose-headings:text-foreground prose-headings:text-3xl prose-headings:border-b prose-headings:border-accent prose-headings:pb-2 text-justify prose-p:text-foreground prose-strong:text-foreground prose-code:text-primary prose-h3:border-b-0 prose-h3:text-2xl prose-strong:font-bold prose-a:text-primary prose-pre:bg-muted prose-pre:border-none prose-blockquote:border-l-primary"
            >
                <Content />
            </div>
        </article>

        <aside
            class="hidden 2xl:block 2xl:w-64 2xl:fixed 2xl:right-12 2xl:top-20"
        >
            <!-- <ArticleTimeline client:load /> -->
        </aside>

        <!-- <div class="border-t border-border pt-8 lg:max-w-6xl">
            <a
                href="/"
                class="text-primary hover:text-primary/80 transition-colors"
            >
                ← Back to home
            </a>
        </div> -->
    </main>
</BaseLayout>

<style>
    article {
        animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(4px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
