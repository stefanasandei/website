---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleBody from "../../components/ArticleBody.astro";
import SlugHeader from "../../components/SlugHeader.astro";
import Tag from "../../components/Tag.svelte";
import TableOfContents from "../../components/TableOfContents.svelte";
import ReadingProgress from "../../components/ReadingProgress.svelte";
import Citation from "../../components/Citation.svelte";
import { wordCount, readingTime } from "../../lib/reading-time";
import { tagColorIndex } from "../../lib/tags";
import { blogSlug, isArchived } from "../../lib/blog";

export async function getStaticPaths() {
    const blogEntries = await getCollection("blog");
    return blogEntries.map((entry) => ({
        params: { slug: blogSlug(entry.id) },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const minutes = readingTime(entry.body);
const words = wordCount(entry.body);

// prev / next navigation (sorted newest first)
const allPosts = (await getCollection("blog"))
    .filter((post) => !post.data.hidden)
    .filter((post) => isArchived(post) === isArchived(entry))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const index = allPosts.findIndex((p) => p.id === entry.id);
const newerPost = index > 0 ? allPosts[index - 1] : null;
const olderPost =
    index >= 0 && index < allPosts.length - 1 ? allPosts[index + 1] : null;
---

<BaseLayout
    title={`${entry.data.title} - Asandei`}
    description={entry.data.description || entry.data.title}
>
    <ReadingProgress client:load />

    <main class="px-2 lg:px-0 lg:max-w-6xl lg:mx-auto w-full">
        <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_13rem] lg:gap-12">
            <article class="slug-article w-full min-w-0">
                <SlugHeader
                    title={entry.data.title}
                    description={entry.data.description}
                >
                    <Fragment slot="meta">
                        <time datetime={entry.data.date.toISOString()}>
                            {
                                entry.data.date.toLocaleDateString("en-US", {
                                    year: "numeric",
                                    month: "long",
                                    day: "numeric",
                                })
                            }
                        </time>
                        <span aria-hidden="true">·</span>
                        <span>{minutes} min read</span>
                        <span aria-hidden="true">·</span>
                        <span>{words} words</span>
                        {
                            entry.data.tags && entry.data.tags.length > 0 && (
                                <>
                                    <span aria-hidden="true">·</span>
                                    <span class="flex flex-wrap gap-1">
                                        {entry.data.tags.map((tag) => (
                                            <Tag
                                                {tag}
                                                href={`/blog?tag=${tag}`}
                                                colorIndex={tagColorIndex(tag)}
                                            />
                                        ))}
                                    </span>
                                </>
                            )
                        }
                    </Fragment>
                </SlugHeader>

                <!-- Collapsible contents on small screens -->
                <div class="lg:hidden mb-8">
                    <TableOfContents {headings} variant="inline" client:load />
                </div>

                <ArticleBody>
                    <Content />
                </ArticleBody>

                <!-- Citation -->
                <div class="mt-12">
                    <Citation
                        title={entry.data.title}
                        date={entry.data.date}
                        path={`/blog/${blogSlug(entry.id)}`}
                        client:load
                    />
                </div>

                <!-- Prev / next -->
                <nav
                    class="mt-8 flex items-start justify-between gap-4 border-t border-border pt-6 text-sm"
                    aria-label="More posts"
                >
                    <div class="min-w-0">
                        {
                            newerPost && (
                                <a
                                    href={`/blog/${blogSlug(newerPost.id)}`}
                                    class="group inline-flex flex-col"
                                >
                                    <span class="text-sm text-muted-foreground">
                                        newer
                                    </span>
                                    <span class="text-primary group-hover:underline truncate">
                                        {newerPost.data.title}
                                    </span>
                                </a>
                            )
                        }
                    </div>
                    <div class="min-w-0 text-right">
                        {
                            olderPost && (
                                <a
                                    href={`/blog/${blogSlug(olderPost.id)}`}
                                    class="group inline-flex flex-col"
                                >
                                    <span class="text-sm text-muted-foreground">
                                        older
                                    </span>
                                    <span class="text-primary group-hover:underline truncate">
                                        {olderPost.data.title}
                                    </span>
                                </a>
                            )
                        }
                    </div>
                </nav>
            </article>

            <!-- Sticky chapter sidebar -->
            <aside class="hidden lg:block min-w-0">
                <div class="sticky top-20">
                    <TableOfContents {headings} variant="sidebar" client:load />
                </div>
            </aside>
        </div>
    </main>
</BaseLayout>
