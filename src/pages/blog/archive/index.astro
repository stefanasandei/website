---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import SectionTitle from "../../../components/SectionTitle.svelte";
import CoolLink from "../../../components/CoolLink.svelte";
import Tag from "../../../components/Tag.svelte";
import { readingTime } from "../../../lib/reading-time";
import { tagColorIndex } from "../../../lib/tags";
import { blogSlug, isArchived } from "../../../lib/blog";

// Get all blog posts sorted by date (newest first)
const allPosts = (await getCollection("blog"))
    .filter((post) => !post.data.hidden)
    .filter((post) => isArchived(post))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    .map((post) => ({ ...post, minutes: readingTime(post.body) }));

// Group by year, preserving the date sort (an academic archive feel)
const years = [...new Set(allPosts.map((p) => p.data.date.getFullYear()))];
---

<BaseLayout
    title="Blog Archive - Asandei"
    description="Collection of articles and thoughts on machine learning, research, and technology"
>
    <div
        class="md:max-w-2xl min-h-[85vh] px-2 lg:max-w-6xl mx-2 md:mx-auto flex flex-col gap-12"
    >
        <div class="space-y-6">
            <div class="flex justify-between items-center">
                <SectionTitle haveBorder={false} large={true}>Archive</SectionTitle
                >
                <div class="flex items-center gap-3">
                    <a
                        href="/blog"
                        class="rounded-md border border-border px-3 py-1.5 text-sm hover:border-primary/50 hover:text-primary transition-colors"
                    >Current posts</a>
                    <div id="current-tag-container"></div>
                </div>
            </div>

            <p
                class="text-lg leading-relaxed text-justify text-muted-foreground"
            >
                Older writing from 2021–2025, preserved from my previous website. Explore topics in
                systems programming, C++, machine learning, and technology.
            </p>

            <div id="posts-container" class="space-y-10">
                {
                    years.map((year) => (
                        <section class="year-group">
                            <div class="flex items-baseline gap-3 border-b border-border pb-2">
                                <span class="text-primary font-extrabold text-xl">
                                    <sup>*</sup>
                                </span>
                                <h2 class="text-xl font-bold tracking-tight">
                                    {year}
                                </h2>
                                <span class="text-sm text-muted-foreground">
                                    {
                                        allPosts.filter(
                                            (p) =>
                                                p.data.date.getFullYear() ===
                                                year,
                                        ).length
                                    }{" "}
                                    posts
                                </span>
                            </div>

                            <div>
                                {allPosts
                                    .filter(
                                        (p) =>
                                            p.data.date.getFullYear() === year,
                                    )
                                    .map((post) => (
                                        <div
                                            class="py-4 post-item border-b border-border"
                                            data-tags={JSON.stringify(
                                                post.data.tags || [],
                                            )}
                                        >
                                            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-4 mb-2">
                                                <a
                                                    href={`/blog/${blogSlug(post.id)}`}
                                                    class="hover:text-primary transition-colors duration-100 text-lg font-medium"
                                                >
                                                    {post.data.title}
                                                </a>
                                                <span class="text-muted-foreground text-sm whitespace-nowrap shrink-0">
                                                    {post.data.date.toLocaleDateString(
                                                        "en-US",
                                                        {
                                                            year: "numeric",
                                                            month: "short",
                                                            day: "numeric",
                                                        },
                                                    )}
                                                </span>
                                            </div>
                                            <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                                                <span class="text-sm text-muted-foreground">
                                                    {post.minutes} min read
                                                </span>
                                                {post.data.tags &&
                                                    post.data.tags.length >
                                                        0 && (
                                                        <div class="flex flex-wrap gap-1">
                                                            {post.data.tags.map(
                                                                (tag) => (
                                                                    <Tag
                                                                        {tag}
                                                                        href={`/blog/archive?tag=${tag}`}
                                                                        colorIndex={tagColorIndex(
                                                                            tag,
                                                                        )}
                                                                    />
                                                                ),
                                                            )}
                                                        </div>
                                                    )}
                                            </div>
                                        </div>
                                    ))}
                            </div>
                        </section>
                    ))
                }
            </div>
        </div>
    </div>
</BaseLayout>

<style>
    .post-item {
        animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(4px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script>
    import { tagColors, tagColorIndex } from "../../../lib/tags";

    function colorClassFor(tag: string) {
        return tagColors[tagColorIndex(tag)];
    }

    function filterPosts() {
        const urlParams = new URLSearchParams(window.location.search);
        const tag = urlParams.get("tag");

        const postItems = document.querySelectorAll(".post-item");

        // First, update visibility based on tag filter
        postItems.forEach((item) => {
            const element = item as HTMLElement;
            const tags = JSON.parse(element.dataset.tags || "[]");
            if (tag && !tags.includes(tag)) {
                element.style.display = "none";
            } else {
                element.style.display = "block";
            }
        });

        // Update border classes based on visible posts within each year
        const yearGroups = document.querySelectorAll(".year-group");
        yearGroups.forEach((group) => {
            const visiblePosts = Array.from(
                group.querySelectorAll(".post-item"),
            ).filter(
                (item) => (item as HTMLElement).style.display !== "none",
            ) as HTMLElement[];

            // hide the whole year section if nothing is visible
            (group as HTMLElement).style.display =
                visiblePosts.length === 0 ? "none" : "block";

            visiblePosts.forEach((item, index) => {
                if (index < visiblePosts.length - 1) {
                    item.classList.add("border-b", "border-border");
                } else {
                    item.classList.remove("border-b", "border-border");
                }
            });
        });

        // Update the current tag display
        const currentTagContainer = document.getElementById(
            "current-tag-container",
        ) as HTMLElement;
        if (currentTagContainer) {
            currentTagContainer.innerHTML = tag
                ? `<button onclick="window.history.pushState({}, '', '/blog/archive'); filterPosts();" class="text-sm ${colorClassFor(tag)} px-2 py-1 rounded-md hover:bg-primary hover:text-primary-foreground transition-colors inline-block cursor-pointer">#${tag}</button>`
                : "";
        }
    }

    // Filter on page load
    filterPosts();

    // Also filter when URL changes (for SPA-like behavior)
    window.addEventListener("popstate", filterPosts);

    // Handle tag link clicks
    document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (target.matches("a[href*='?tag=']")) {
            e.preventDefault();
            const href = target.getAttribute("href");
            if (href) {
                const url = new URL(href, window.location.origin);
                window.history.pushState({}, "", url.toString());
                filterPosts();
            }
        }
    });
</script>
