---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleBody from "../../components/ArticleBody.astro";
import ProjectLink from "../../components/ProjectLink.svelte";
import SlugHeader from "../../components/SlugHeader.astro";
import TableOfContents from "../../components/TableOfContents.svelte";
import ReadingProgress from "../../components/ReadingProgress.svelte";
import { tagColorIndex, tagColors } from "../../lib/tags";

export async function getStaticPaths() {
    const projectEntries = await getCollection("project");
    return projectEntries.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const allProjects = (await getCollection("project")).sort(
    (a, b) => b.data.year - a.data.year,
);
const index = allProjects.findIndex((p) => p.id === entry.id);
const newerProject = index > 0 ? allProjects[index - 1] : null;
const olderProject =
    index >= 0 && index < allProjects.length - 1
        ? allProjects[index + 1]
        : null;
---

<BaseLayout
    title={`${entry.data.title} - Projects - Asandei`}
    description={entry.data.description}
>
    <ReadingProgress client:load />

    <!-- Project slugs share the blog article shell. -->
    <main class="px-2 lg:px-0 lg:max-w-6xl lg:mx-auto w-full">
        <SlugHeader
            title={entry.data.title}
            description={entry.data.description}
        >
            <Fragment slot="meta">
                <span>{entry.data.year}</span>
                <span aria-hidden="true">·</span>
                <a
                    href={`/projects?category=${entry.data.category}`}
                    class="hover:text-primary transition-colors"
                >
                    #{entry.data.category}
                </a>
                <span aria-hidden="true">·</span>
                <span class="flex flex-wrap items-center gap-1">
                    {entry.data.tech.map((tech) => (
                        <span
                            class={`text-sm ${tagColors[tagColorIndex(tech)]} px-2 py-1 rounded-md inline-block`}
                        >
                            {tech}
                        </span>
                    ))}
                </span>
                <div class="ml-auto flex w-full flex-wrap items-center gap-2 sm:w-auto">
                    {
                        entry.data.links.github && (
                            <ProjectLink
                                href={entry.data.links.github}
                                type="github"
                                label="Source"
                            />
                        )
                    }
                    {
                        entry.data.links.demo && (
                            <ProjectLink
                                href={entry.data.links.demo}
                                type="demo"
                                label="Demo"
                            />
                        )
                    }
                    {
                        entry.data.links.paper && (
                            <ProjectLink
                                href={entry.data.links.paper}
                                type="paper"
                                label="Paper"
                            />
                        )
                    }
                    {
                        entry.data.links.docs && (
                            <ProjectLink
                                href={entry.data.links.docs}
                                type="docs"
                                label="Docs"
                            />
                        )
                    }
                </div>
            </Fragment>
        </SlugHeader>

        <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_13rem] lg:gap-12">
            <article class="slug-article w-full min-w-0">
                <div class="lg:hidden mb-8">
                    <TableOfContents {headings} variant="inline" client:load />
                </div>

                <ArticleBody>
                    <Content />
                </ArticleBody>

                <nav
                    class="mt-8 flex items-start justify-between gap-4 border-t border-border pt-6 text-sm"
                    aria-label="More projects"
                >
                    <div class="min-w-0">
                        {
                            newerProject && (
                                <a
                                    href={`/projects/${newerProject.id}`}
                                    class="group inline-flex flex-col"
                                >
                                    <span class="text-sm text-muted-foreground">
                                        newer
                                    </span>
                                    <span class="text-primary group-hover:underline truncate">
                                        {newerProject.data.title}
                                    </span>
                                </a>
                            )
                        }
                    </div>
                    <div class="min-w-0 text-right">
                        {
                            olderProject && (
                                <a
                                    href={`/projects/${olderProject.id}`}
                                    class="group inline-flex flex-col"
                                >
                                    <span class="text-sm text-muted-foreground">
                                        older
                                    </span>
                                    <span class="text-primary group-hover:underline truncate">
                                        {olderProject.data.title}
                                    </span>
                                </a>
                            )
                        }
                    </div>
                </nav>
            </article>

            <aside class="hidden lg:block min-w-0">
                <div class="sticky top-20">
                    <TableOfContents {headings} variant="sidebar" client:load />
                </div>
            </aside>
        </div>
    </main>
</BaseLayout>
