---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionTitle from "../../components/SectionTitle.svelte";

export async function getStaticPaths() {
    const projectEntries = await getCollection("project");
    return projectEntries.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const allProjects = await getCollection("project");
const relatedProjects = allProjects
    .filter((p) => p.data.category === entry.data.category && p.id !== entry.id)
    .slice(0, 2);
---

<BaseLayout
    title={`${entry.data.title} - Projects - Asandei`}
    description={entry.data.description}
>
    <main class="md:max-w-2xl px-2 lg:max-w-4xl mx-2 md:mx-auto">
        <!-- Breadcrumb -->
        <nav class="mb-8 text-sm text-muted-foreground">
            <a href="/projects" class="hover:text-primary transition-colors"
                >Projects</a
            >
            <span class="mx-2">/</span>
            <span class="text-foreground">{entry.data.title}</span>
        </nav>

        <article class="space-y-8">
            <!-- Header -->
            <header class="space-y-6 pb-8 border-b border-border">
                <div class="space-y-3">
                    <div class="flex items-center gap-3 text-xs font-mono">
                        <span
                            class="uppercase tracking-widest text-muted-foreground px-2 py-1 border border-border"
                        >
                            {entry.data.category}
                        </span>
                        <span class="text-muted-foreground">•</span>
                        <span class="text-muted-foreground"
                            >{entry.data.year}</span
                        >
                    </div>

                    <h1 class="text-3xl md:text-4xl font-bold tracking-tight">
                        {entry.data.title}
                    </h1>

                    <p
                        class="text-lg text-muted-foreground leading-relaxed max-w-2xl"
                    >
                        {entry.data.description}
                    </p>
                </div>

                <!-- Quick Links -->
                <div class="flex flex-wrap gap-3">
                    {
                        entry.data.links.github && (
                            <a
                                href={entry.data.links.github}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-2 px-4 py-2 text-sm border border-border hover:border-primary hover:text-primary transition-all"
                            >
                                <svg
                                    class="w-4 h-4"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                                </svg>
                                Source Code
                            </a>
                        )
                    }
                    {
                        entry.data.links.demo && (
                            <a
                                href={entry.data.links.demo}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-2 px-4 py-2 text-sm bg-primary text-primary-foreground hover:bg-primary/90 transition-all"
                            >
                                Live Demo
                                <span>↗</span>
                            </a>
                        )
                    }
                    {
                        entry.data.links.paper && (
                            <a
                                href={entry.data.links.paper}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-2 px-4 py-2 text-sm border border-border hover:border-primary hover:text-primary transition-all"
                            >
                                <svg
                                    class="w-4 h-4"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                                    />
                                </svg>
                                Read Paper
                            </a>
                        )
                    }
                    {
                        entry.data.links.docs && (
                            <a
                                href={entry.data.links.docs}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-2 px-4 py-2 text-sm border border-border hover:border-primary hover:text-primary transition-all"
                            >
                                Documentation
                            </a>
                        )
                    }
                </div>
            </header>

            <!-- Sidebar Info + Content Layout -->
            <div class="lg:grid lg:grid-cols-[1fr_240px] lg:gap-12">
                <!-- Main Content -->
                <div
                    class="prose prose-invert max-w-none
            prose-headings:font-semibold prose-headings:tracking-tight
            prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-4 prose-h2:pb-2 prose-h2:border-b prose-h2:border-border
            prose-h3:text-lg prose-h3:mt-6 prose-h3:mb-3
            prose-p:text-foreground/90 prose-p:leading-relaxed
            prose-a:text-primary prose-a:no-underline hover:prose-a:underline
            prose-code:text-primary prose-code:bg-muted prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none
            prose-pre:bg-muted prose-pre:border prose-pre:border-border
            prose-blockquote:border-l-2 prose-blockquote:border-primary prose-blockquote:pl-4 prose-blockquote:italic prose-blockquote:text-muted-foreground
            prose-li:text-foreground/90
            prose-strong:text-foreground"
                >
                    <Content />
                </div>

                <!-- Sidebar -->
                <aside class="hidden lg:block space-y-8 text-sm">
                    <div class="sticky top-8 space-y-8">
                        <!-- Tech Stack -->
                        {
                            entry.data.tech && entry.data.tech.length > 0 && (
                                <div class="space-y-3">
                                    <h4 class="text-xs font-mono uppercase tracking-widest text-muted-foreground">
                                        Technologies
                                    </h4>
                                    <div class="flex flex-wrap gap-1.5">
                                        {entry.data.tech.map((tech: string) => (
                                            <span class="px-2 py-1 bg-muted text-foreground font-mono text-xs">
                                                {tech}
                                            </span>
                                        ))}
                                    </div>
                                </div>
                            )
                        }

                        <!-- Achievements -->
                        {
                            entry.data.achievements &&
                                entry.data.achievements.length > 0 && (
                                    <div class="space-y-3">
                                        <h4 class="text-xs font-mono uppercase tracking-widest text-muted-foreground">
                                            Achievements
                                        </h4>
                                        <ul class="space-y-2">
                                            {entry.data.achievements.map(
                                                (achievement: string) => (
                                                    <li class="flex gap-2 text-foreground/80">
                                                        <span class="text-primary shrink-0">
                                                            →
                                                        </span>
                                                        <span>
                                                            {achievement}
                                                        </span>
                                                    </li>
                                                ),
                                            )}
                                        </ul>
                                    </div>
                                )
                        }
                    </div>
                </aside>
            </div>

            <!-- Mobile: Tech & Achievements -->
            <div class="lg:hidden space-y-6 pt-6 border-t border-border">
                {
                    entry.data.tech && entry.data.tech.length > 0 && (
                        <div class="space-y-3">
                            <h4 class="text-xs font-mono uppercase tracking-widest text-muted-foreground">
                                Technologies
                            </h4>
                            <div class="flex flex-wrap gap-1.5">
                                {entry.data.tech.map((tech: string) => (
                                    <span class="px-2 py-1 bg-muted text-foreground font-mono text-xs">
                                        {tech}
                                    </span>
                                ))}
                            </div>
                        </div>
                    )
                }

                {
                    entry.data.achievements &&
                        entry.data.achievements.length > 0 && (
                            <div class="space-y-3">
                                <h4 class="text-xs font-mono uppercase tracking-widest text-muted-foreground">
                                    Achievements
                                </h4>
                                <ul class="space-y-2 text-sm">
                                    {entry.data.achievements.map(
                                        (achievement: string) => (
                                            <li class="flex gap-2 text-foreground/80">
                                                <span class="text-primary shrink-0">
                                                    →
                                                </span>
                                                <span>{achievement}</span>
                                            </li>
                                        ),
                                    )}
                                </ul>
                            </div>
                        )
                }
            </div>

            <!-- Related Projects -->
            {
                relatedProjects.length > 0 && (
                    <section class="pt-8 border-t border-border space-y-4">
                        <h3 class="text-xs font-mono uppercase tracking-widest text-muted-foreground">
                            Related Projects
                        </h3>
                        <div class="grid sm:grid-cols-2 gap-4">
                            {relatedProjects.map((project) => (
                                <a
                                    href={`/projects/${project.id}`}
                                    class="group p-4 border border-border hover:border-primary/50 transition-all"
                                >
                                    <h4 class="font-semibold group-hover:text-primary transition-colors">
                                        {project.data.title}
                                    </h4>
                                    <p class="text-sm text-muted-foreground mt-1 line-clamp-2">
                                        {project.data.description}
                                    </p>
                                </a>
                            ))}
                        </div>
                    </section>
                )
            }

            <!-- Back Navigation -->
            <nav class="pt-8 border-t border-border">
                <a
                    href="/projects"
                    class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-primary transition-colors group"
                >
                    <span
                        class="group-hover:-translate-x-1 transition-transform duration-200"
                        >←</span
                    >
                    <span>Back to all projects</span>
                </a>
            </nav>
        </article>
    </main>
</BaseLayout>
