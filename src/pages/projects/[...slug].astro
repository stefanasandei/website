---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionTitle from "../../components/SectionTitle.svelte";
import CoolLink from "../../components/CoolLink.svelte";

export async function getStaticPaths() {
    const projectEntries = await getCollection("project");
    return projectEntries.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const allProjects = await getCollection("project");
const otherProjects = allProjects.filter((p) => p.id !== entry.id).slice(0, 3);

// Icons for links
const linkIcons = {
    github: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>`,
    demo: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>`,
    paper: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>`,
    docs: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>`,
};
---

<BaseLayout
    title={`${entry.data.title} - Projects - Asandei`}
    description={entry.data.description}
>
    <main class="px-2 lg:px-0 lg:max-w-none flex flex-col gap-6">
        <!-- Hero Section -->
        <article class="lg:max-w-6xl lg:mx-auto w-full">
            <!-- Title Row with Links -->
            <div
                class="flex flex-col pb-2 border-b border-border sm:flex-row sm:items-start sm:justify-between gap-4 mb-4"
            >
                <h2 class="text-lg font-bold">
                    <span
                        class={`text-primary font-extrabold ${true ? "text-4xl" : "text-2xl"}`}
                        >*</span
                    >
                    <span class={`${true ? "text-4xl" : "text-2xl"}`}>
                        {entry.data.title}
                    </span>
                </h2>

                <!-- Links on the right -->
                <div class="flex flex-wrap items-center gap-2 sm:shrink-0">
                    {
                        entry.data.links.github && (
                            <a
                                href={entry.data.links.github}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-card hover:bg-primary/10 text-foreground transition-all duration-200 group text-sm"
                            >
                                <span
                                    class="text-muted-foreground group-hover:text-primary transition-colors"
                                    set:html={linkIcons.github}
                                />
                                <span>Source</span>
                            </a>
                        )
                    }
                    {
                        entry.data.links.paper && (
                            <a
                                href={entry.data.links.paper}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-card hover:bg-primary/10 text-foreground border border-border hover:border-primary/50 transition-all duration-200 group text-sm"
                            >
                                <span
                                    class="text-muted-foreground group-hover:text-primary transition-colors"
                                    set:html={linkIcons.paper}
                                />
                                <span>Paper</span>
                            </a>
                        )
                    }
                </div>
            </div>

            <!-- Meta info row: year, category, tech stack -->
            <div class="flex flex-row justify-between">
                <div
                    class="flex flex-wrap items-center gap-x-2 gap-y-2 text-sm text-muted-foreground mb-6"
                >
                    <span
                        class="bg-secondary text-secondary-foreground px-2 py-0.5 rounded-md text-xs"
                    >
                        {entry.data.year}
                    </span>
                    <a
                        href={`/projects?category=${entry.data.category}`}
                        class="text-xs bg-secondary text-secondary-foreground px-2 py-0.5 rounded-md hover:bg-primary hover:text-primary-foreground transition-colors inline-block cursor-pointer"
                    >
                        #{entry.data.category}
                    </a>
                </div>
                <!-- <span class="text-foreground/80">{entry.data.category}</span> -->
                <div>
                    {
                        entry.data.tech.length > 0 && (
                            <span class="text-foreground/60">
                                {entry.data.tech.join(" • ")}
                            </span>
                        )
                    }
                </div>
            </div>

            {
                entry.data.achievements &&
                    entry.data.achievements.length > 0 && (
                        <section class="lg:max-w-6xl lg:mx-auto w-full flex flex-col gap-4">
                            <h3 class="text-lg font-semibold text-muted-foreground tracking-wider">
                                Achievements:
                            </h3>
                            <div class="flex flex-col gap-3">
                                {entry.data.achievements.map((achievement) => (
                                    <div class="flex items-center gap-3 text-foreground/90">
                                        <span class="w-1.5 h-1.5 rounded-full bg-primary shrink-0 mt-1" />
                                        <span class="leading-relaxed">
                                            {achievement}
                                        </span>
                                    </div>
                                ))}
                            </div>
                        </section>
                    )
            }
        </article>

        <!-- Main Content -->
        <article class="prose w-full prose-invert lg:max-w-6xl lg:mx-auto">
            <div
                class="prose-headings:text-foreground prose-headings:text-2xl prose-headings:border-b prose-headings:border-accent prose-headings:pb-2 prose-headings:mb-4 text-justify prose-p:text-foreground/90 prose-strong:text-foreground prose-code:text-primary prose-h3:border-b-0 prose-h3:text-xl prose-strong:font-bold prose-a:text-primary prose-pre:bg-muted prose-pre:border-none prose-blockquote:border-l-primary prose-li:text-foreground/90"
            >
                <Content />
            </div>
        </article>

        <!-- Other Projects Section -->
        {
            otherProjects.length > 0 && (
                <section class="lg:max-w-6xl lg:mx-auto w-full border-t border-border pt-8">
                    <h3 class="text-lg font-semibold mb-6 text-muted-foreground">
                        Other Projects
                    </h3>
                    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        {otherProjects.map((project) => (
                            <a
                                href={`/projects/${project.id}`}
                                class="group p-4 rounded-xl bg-card/50 hover:bg-card border border-border/50 hover:border-primary/30 transition-all duration-200"
                            >
                                <div class="flex flex-col gap-2">
                                    <span class="font-semibold text-foreground group-hover:text-primary transition-colors">
                                        {project.data.title}
                                    </span>
                                    <span class="text-sm text-muted-foreground line-clamp-2">
                                        {project.data.description}
                                    </span>
                                    <div class="flex flex-wrap gap-1.5 mt-1">
                                        {project.data.tech
                                            .slice(0, 3)
                                            .map((tech) => (
                                                <span class="text-xs bg-secondary text-secondary-foreground px-2 py-0.5 rounded-md">
                                                    {tech}
                                                </span>
                                            ))}
                                    </div>
                                </div>
                            </a>
                        ))}
                    </div>

                    <nav class="pt-4">
                        <CoolLink href="/projects">all projects</CoolLink>
                    </nav>
                </section>
            )
        }
    </main>
</BaseLayout>

<style>
    section,
    article {
        animation: fadeIn 0.4s ease;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Line clamp utility */
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
