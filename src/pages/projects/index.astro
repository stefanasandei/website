---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import SectionTitle from "../../components/SectionTitle.svelte";
import Tag from "../../components/Tag.svelte";

const allProjects = (await getCollection("project")).sort(
  (a, b) => b.data.year - a.data.year,
);

const categories = [...new Set(allProjects.map((p) => p.data.category))];
---

<BaseLayout
  title="Projects - Asandei"
  description="Collection of research projects, open source tools, and experiments"
>
  <div
    class="md:max-w-2xl min-h-[85vh] px-2 lg:max-w-6xl mx-2 md:mx-auto flex flex-col gap-12"
  >
    <div class="space-y-6">
      <div class="flex justify-between items-center">
        <SectionTitle haveBorder={false} large={true}>projects</SectionTitle>
        <div id="current-category-container"></div>
      </div>

      <p class="text-lg leading-relaxed text-justify text-muted-foreground">
        A collection of research projects, open source tools, and experimental
        work spanning machine learning, systems programming, and beyond.
      </p>

      <div id="projects-container">
        {
          allProjects.map((project) => (
            <div
              class="py-5 project-item"
              data-category={project.data.category}
            >
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-4 mb-2">
                <a
                  href={`/projects/${project.id}`}
                  class="hover:text-primary transition-colors duration-100 text-lg font-medium"
                >
                  {project.data.title}
                </a>
                <span class="text-muted-foreground text-sm whitespace-nowrap shrink-0">
                  {project.data.year}
                </span>
              </div>

              <p class="text-sm text-muted-foreground leading-relaxed mb-3 line-clamp-2">
                {project.data.description}
              </p>

              <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                <Tag
                  tag={project.data.category}
                  href={`/projects?category=${project.data.category}`}
                />

                {project.data.tech && project.data.tech.length > 0 && (
                  <span class="text-xs text-muted-foreground font-mono">
                    {project.data.tech.slice(0, 3).join(" · ")}
                    {project.data.tech.length > 3 &&
                      ` +${project.data.tech.length - 3}`}
                  </span>
                )}

                <div class="flex gap-3 ml-auto">
                  {project.data.links.github && (
                    <a
                      href={project.data.links.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-xs text-muted-foreground hover:text-primary transition-colors"
                    >
                      github
                    </a>
                  )}
                  {project.data.links.demo && (
                    <a
                      href={project.data.links.demo}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-xs text-muted-foreground hover:text-primary transition-colors"
                    >
                      demo
                    </a>
                  )}
                  {project.data.links.paper && (
                    <a
                      href={project.data.links.paper}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-xs text-muted-foreground hover:text-primary transition-colors"
                    >
                      paper
                    </a>
                  )}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .project-item {
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  function filterProjects() {
    const urlParams = new URLSearchParams(window.location.search);
    const category = urlParams.get("category");

    const projectItems = document.querySelectorAll(".project-item");

    projectItems.forEach((item) => {
      const element = item as HTMLElement;
      const itemCategory = element.dataset.category;
      if (category && itemCategory !== category) {
        element.style.display = "none";
      } else {
        element.style.display = "block";
      }
    });

    const visibleProjects = Array.from(projectItems).filter((item) => {
      return (item as HTMLElement).style.display !== "none";
    });

    visibleProjects.forEach((item, index) => {
      const element = item as HTMLElement;
      if (index < visibleProjects.length - 1) {
        element.classList.add("border-b", "border-border");
      } else {
        element.classList.remove("border-b", "border-border");
      }
    });

    const currentCategoryContainer = document.getElementById(
      "current-category-container",
    ) as HTMLElement;
    if (currentCategoryContainer) {
      currentCategoryContainer.innerHTML = category
        ? `<button onclick="window.history.pushState({}, '', '/projects'); filterProjects();" class="text-xs bg-secondary text-secondary-foreground px-2 py-1 rounded-md hover:bg-primary hover:text-primary-foreground transition-colors inline-block cursor-pointer">${category}</button>`
        : "";
    }
  }

  filterProjects();

  window.addEventListener("popstate", filterProjects);

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.matches("a[href*='?category=']")) {
      e.preventDefault();
      const href = target.getAttribute("href");
      if (href) {
        const url = new URL(href, window.location.origin);
        window.history.pushState({}, "", url.toString());
        filterProjects();
      }
    }
  });
</script>
