---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import SectionTitle from "../../components/SectionTitle.svelte";
import Tag from "../../components/Tag.svelte";
import ProjectLink from "../../components/ProjectLink.svelte";

const allProjects = (await getCollection("project")).sort(
  (a, b) => b.data.year - a.data.year,
);

const categories = [...new Set(allProjects.map((p) => p.data.category))];
const countFor = (c: string) =>
  allProjects.filter((p) => p.data.category === c).length;
---

<BaseLayout
  title="Projects - Asandei"
  description="Collection of research projects, open source tools, and experiments"
>
  <div
    class="md:max-w-2xl min-h-[85vh] px-2 lg:max-w-6xl mx-2 md:mx-auto flex flex-col gap-12"
  >
    <div class="space-y-6">
      <SectionTitle haveBorder={false} large={true}>Projects</SectionTitle>

      <p class="text-lg leading-relaxed text-justify text-muted-foreground">
        A collection of research projects, open source tools, and experimental
        work spanning machine learning, systems programming, and beyond.
      </p>

      <!-- Category filter -->
      <div class="flex flex-wrap items-center gap-2" id="category-pills">
        <a
          href="/projects"
          data-category=""
          class="category-pill text-sm px-2.5 py-1 rounded-md border transition-colors cursor-pointer"
        >
          all <span class="font-extrabold">·</span>
          {allProjects.length}
        </a>
        {
          categories.map((category) => (
            <a
              href={`/projects?category=${category}`}
              data-category={category}
              class="category-pill text-sm px-2.5 py-1 rounded-md border transition-colors cursor-pointer"
            >
              {category} <span class="font-extrabold">·</span>{" "}
              {countFor(category)}
            </a>
          ))
        }
      </div>

      <!-- Bibliography-style list -->
      <div id="projects-container">
        {
          allProjects.map((project) => (
            <div class="project-item" data-category={project.data.category}>
              <div class="group grid sm:grid-cols-[3.5rem_minmax(0,1fr)] gap-x-5 gap-y-1 px-2 py-5 hover:bg-muted/40 transition-colors duration-200">
                <span class="hidden sm:block text-sm text-muted-foreground pt-1 tabular-nums">
                  {project.data.year}
                </span>

                <div class="min-w-0">
                  <div class="flex items-start justify-between gap-3">
                    <div class="flex items-baseline gap-3 flex-wrap min-w-0">
                      <a
                        href={`/projects/${project.id}`}
                        class="text-lg font-medium hover:text-primary transition-colors duration-100"
                      >
                        {project.data.title}
                      </a>
                      <span class="sm:hidden text-sm text-muted-foreground">
                        {project.data.year}
                      </span>
                    </div>
                    <div class="flex flex-wrap justify-end gap-2 shrink-0">
                      {project.data.links.github && (
                        <ProjectLink
                          href={project.data.links.github}
                          type="github"
                          label="Source"
                        />
                      )}
                      {project.data.links.demo && (
                        <ProjectLink
                          href={project.data.links.demo}
                          type="demo"
                          label="Demo"
                        />
                      )}
                      {project.data.links.paper && (
                        <ProjectLink
                          href={project.data.links.paper}
                          type="paper"
                          label="Paper"
                        />
                      )}
                    </div>
                  </div>
                  <p class="text-sm text-muted-foreground leading-relaxed mt-1 line-clamp-2">
                    {project.data.description}
                  </p>
                  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mt-2.5">
                    <Tag
                      tag={project.data.category}
                      href={`/projects?category=${project.data.category}`}
                    />
                    {project.data.tech && project.data.tech.length > 0 && (
                      <span class="text-sm text-muted-foreground">
                        {project.data.tech.slice(0, 3).join(" · ")}
                        {project.data.tech.length > 3 &&
                          ` +${project.data.tech.length - 3}`}
                        </span>
                      )}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .project-item {
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .category-pill {
    background: var(--secondary);
    color: var(--secondary-foreground);
    border-color: transparent;
  }

  .category-pill:hover {
    background: color-mix(in oklch, var(--primary) 20%, transparent);
    color: var(--foreground);
  }

  .category-pill.active {
    background: var(--primary);
    color: var(--primary-foreground);
    border-color: var(--primary);
  }
</style>

<script>
  function filterProjects() {
    const urlParams = new URLSearchParams(window.location.search);
    const category = urlParams.get("category");

    // toggle pill active states
    document.querySelectorAll(".category-pill").forEach((pill) => {
      const el = pill as HTMLElement;
      const pillCategory = el.dataset.category || "";
      el.classList.toggle("active", pillCategory === (category || ""));
    });

    // toggle project visibility
    const projectItems = document.querySelectorAll(".project-item");
    projectItems.forEach((item) => {
      const element = item as HTMLElement;
      const itemCategory = element.dataset.category;
      element.style.display =
        category && itemCategory !== category ? "none" : "block";
    });

    // keep borders tidy among visible rows
    const visibleProjects = Array.from(projectItems).filter(
      (item) => (item as HTMLElement).style.display !== "none",
    ) as HTMLElement[];

    visibleProjects.forEach((item, index) => {
      if (index < visibleProjects.length - 1) {
        item.classList.add("border-b", "border-border");
      } else {
        item.classList.remove("border-b", "border-border");
      }
    });
  }

  filterProjects();

  window.addEventListener("popstate", filterProjects);

  document.addEventListener("click", (e) => {
    const target = (e.target as HTMLElement).closest(
      "a[href*='?category='], #category-pills a[href='/projects']",
    ) as HTMLAnchorElement | null;
    if (target) {
      e.preventDefault();
      const url = new URL(target.getAttribute("href")!, window.location.origin);
      window.history.pushState({}, "", url.toString());
      filterProjects();
    }
  });
</script>
