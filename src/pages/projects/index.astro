---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import SectionTitle from "../../components/SectionTitle.svelte";

const allProjects = (await getCollection("project")).sort(
  (a, b) => b.data.year - a.data.year
);

const categories = [
  ...new Set(allProjects.map((p) => p.data.category)),
];
---

<BaseLayout
  title="Projects - Asandei"
  description="Collection of research projects, open source tools, and experiments"
>
  <div class="md:max-w-2xl min-h-[85vh] px-2 lg:max-w-6xl mx-2 md:mx-auto flex flex-col gap-12">
    <!-- Header -->
    <div class="space-y-6">
      <!-- Title and Filters Row -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <SectionTitle haveBorder={false} large={true}>
          projects
        </SectionTitle>
        <div class="flex gap-2 flex-wrap">
          <button class="filter-btn active px-3 py-1.5 text-sm rounded-none border border-border hover:border-primary hover:text-primary hover:bg-primary/5 transition-all duration-200" data-filter="all">
            all
          </button>
          {
            categories.map((cat) => (
              <button class="filter-btn px-3 py-1.5 text-sm rounded-none border border-border hover:border-primary hover:text-primary hover:bg-primary/5 transition-all duration-200 hidden sm:block" data-filter={cat}>
                {cat}
              </button>
            ))
          }
        </div>
      </div>

      <!-- Description -->
      <p class="text-base md:text-lg leading-relaxed text-muted-foreground max-w-4xl text-justify">
        A collection of research projects, open source tools, and experimental work.
      </p>
    </div>

    <!-- Projects Grid -->
    <div id="projects-container" class="space-y-8">
      {
        allProjects.map((project) => (
          <div class="project-item group rounded-none border border-border/50 hover:border-border hover:bg-background/50 transition-all duration-300 p-3 md:p-4" data-category={project.data.category}>
            <!-- Header Section -->
            <div class="space-y-2 mb-6">
              <div class="flex items-baseline gap-3">
                <a href={`/projects/${project.id}`} class="text-xl md:text-2xl font-bold hover:text-primary transition-colors">
                  {project.data.title}
                </a>
                <span class="text-xs text-muted-foreground font-mono whitespace-nowrap">
                  {project.data.year}
                </span>
              </div>
              <p class="text-xs md:text-sm text-muted-foreground uppercase tracking-wider">
                {project.data.category}
              </p>
            </div>

            <!-- Description -->
            <p class="text-sm md:text-base text-foreground leading-relaxed mb-6 text-justify">
              {project.data.description}
            </p>

            <!-- Achievements -->
            {project.data.achievements && (
              <div class="mb-6 space-y-3">
                <h4 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                  Achievements
                </h4>
                <ul class="space-y-2">
                  {project.data.achievements.map((achievement) => (
                    <li class="text-sm text-foreground flex gap-2">
                      <span class="text-primary/70 flex-shrink-0">→</span>
                      <span>{achievement}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Technologies -->
            {project.data.tech && project.data.tech.length > 0 && (
              <div class="mb-6 space-y-3">
                <h4 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                  Technologies
                </h4>
                <div class="flex flex-wrap gap-2">
                  {project.data.tech.map((tech) => (
                    <div class="px-3 py-1.5 rounded-none text-xs font-medium bg-gradient-to-br from-primary/10 to-primary/5 border border-primary/20 text-foreground hover:border-primary/40 hover:bg-primary/15 transition-all duration-200 cursor-default">
                      {tech}
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- Links -->
            <div class="flex gap-4 text-xs font-mono pt-2 flex-wrap">
              {project.data.links.github && (
                <a href={project.data.links.github} target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-primary transition-colors">
                  github
                </a>
              )}
              {project.data.links.demo && (
                <a href={project.data.links.demo} target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-primary transition-colors">
                  demo
                </a>
              )}
              {project.data.links.paper && (
                <a href={project.data.links.paper} target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-primary transition-colors">
                  paper
                </a>
              )}
              {project.data.links.docs && (
                <a href={project.data.links.docs} target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-primary transition-colors">
                  docs
                </a>
              )}
              <a href={`/projects/${project.id}`} class="text-primary hover:text-primary/80 transition-colors ml-auto">
                read more →
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="hidden text-center py-16 text-muted-foreground">
      <p class="text-sm md:text-base">no projects found in this category</p>
    </div>
  </div>
</BaseLayout>

<style>
  .filter-btn {
    transition: all 0.2s ease;
  }

  .filter-btn.active {
    background-color: var(--primary);
    border-color: var(--primary);
    color: var(--primary-foreground);
  }

  .project-item {
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  function initProjectFilters() {
    const filterBtns = document.querySelectorAll(".filter-btn");
    const projectItems = document.querySelectorAll(".project-item");
    const emptyState = document.getElementById("empty-state");

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.getAttribute("data-filter");

        filterBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");

        let visibleCount = 0;

        projectItems.forEach((item) => {
          const category = item.getAttribute("data-category");
          const shouldShow = filter === "all" || category === filter;

          if (shouldShow) {
            (item as HTMLElement).style.display = "";
            visibleCount++;
          } else {
            (item as HTMLElement).style.display = "none";
          }
        });

        if (emptyState) {
          emptyState.style.display =
            visibleCount === 0 ? "block" : "none";
        }
      });
    });
  }

  initProjectFilters();
  document.addEventListener("astro:after-swap", () => {
    initProjectFilters();
  });
</script>