---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.svelte";

// Webring members data
const personalMembers = [
  {
    name: "Mihai Radu",
    pfpUrl: "https://michaelradu.netlify.app/_next/image?url=%2Fimages%2Fpfp.gif&w=128&q=75",
    description: "Self-taught developer, old friend of mine, publishes articles related to low level tech, GNU/Linux and BSD.",
    websiteUrl: "https://michaelradu.netlify.app/"
  },
  {
    name: "Paul Tal",
    pfpUrl: "https://paultal.online/static/profile_picture.jpeg",
    description: "Very talented web and embedded developer, writes about productivity and his various thoughts.",
    websiteUrl: "https://paultal.online/"
  },
  {
    name: "Tudor Morariu",
    pfpUrl: "https://olimpiada.nitro-ai.org/_next/static/media/TudorMorariu2025.9b26b4eb.jpg",
    description: "Friend from the AI Olympiad, he publishes projects and research regarding AI.",
    websiteUrl: "https://MorariuT.github.io"
  },
//   {
//     name: "Gior007",
//     pfpUrl: "https://placehold.co/40x40/",
//     description: "lorem ipsum",
//     websiteUrl: "https://MorariuT.github.io"
//   },
  {
    name: "Nikoloz Gegenava",
    pfpUrl: "https://avatars.githubusercontent.com/u/179756545?v=4",
    description: "IOAI and IPhO Medalist, AICC organizer, he does Machine Learning and Physics research.",
    websiteUrl: "https://www.kaggle.com/nikolasgegenava"
  },
];

const internetMembers = [
{
    name: "Luke Smith",
    pfpUrl: "https://lukesmith.xyz/pix/amanet.jpg",
    description: "Publishes content related to online privacy, digital literacy, as well as GNU/Linux tips.",
    websiteUrl: "https://lukesmith.xyz/"
  },

  {
    name: "Will Brown",
    pfpUrl: "https://avatars.githubusercontent.com/u/9730447?v=4",
    description: "Researcher at Prime Intellect, posts about Reinforcement Learning, Distributed Training. Contributor of the verifiers library, used for RL Environments.",
    websiteUrl: "https://willcb.com/"
  },
  {
    name: "Dominic Rampas",
    pfpUrl: "https://avatars.githubusercontent.com/u/61938694?v=4",
    description: "Posts great education content regarding the inner workings of Image Generation Models. Contributor of the Würstchen architecture, used in Stable Cascade.",
    websiteUrl: "https://www.youtube.com/@outliier/videos"
  },
  {
    name: "Ostris",
    pfpUrl: "https://avatars.githubusercontent.com/u/33983539?s=200&v=4",
    description: "Publishes cool indepent open source work related to Image Generation Models. Creator of the AI Toolkit, for finetuning diffusion models.",
    websiteUrl: "https://github.com/ostris"
  },
 
];
---

<BaseLayout
    title="Asandei - Webring"
    description="Explore my curated webring of talented developers, designers, and technologists"
>
    <div class="md:max-w-2xl min-h-[85vh] px-2 lg:max-w-6xl mx-2 md:mx-auto flex flex-col gap-8 md:gap-12">
        <!-- Header Section -->
        <div class="space-y-6">
            <SectionTitle haveBorder={false} large={true}>
                webring
            </SectionTitle>
            
            <p class="text-base md:text-lg leading-relaxed text-muted-foreground max-w-4xl text-justify">
                A curated collection of talented individuals in technology and innovation.
            </p>
        </div>

        <!-- Personal Connections Section -->
        <div class="space-y-4">
            <h3 class="text-xl font-bold text-foreground border-b border-border/50 pb-2">
                people i personally know
            </h3>
            <div class="grid md:grid-cols-3 gap-6 md:gap-8">
                {personalMembers.map((member) => (
                    <a href={member.websiteUrl} target="_blank" rel="noopener noreferrer" class="webring-card group">
                        <div class="rounded-none border border-border/50 hover:border-border hover:bg-background/50 transition-all duration-300 p-6 h-full flex flex-col">
                            <!-- Profile Section -->
                            <div class="flex items-center gap-3 mb-6">
                                <img
                                src={member.pfpUrl}
                                alt={member.name}
                                style="width: 50px; height: 50px;"
                                class="rounded-full object-cover"
                                />
                                <h3 class="text-2xl font-bold text-foreground group-hover:text-primary transition-colors">
                                    {member.name}
                                </h3>
                            </div>

                            <!-- Description -->
                            <p class="text-sm text-muted-foreground text-justify leading-relaxed mb-6 flex-grow">
                                {member.description}
                            </p>

                            <!-- Visit Link -->
                            <div class="mt-auto">
                                <span class="text-sm text-muted-foreground group-hover:text-primary transition-colors">
                                    visit website
                                </span>
                            </div>
                        </div>
                    </a>
                ))}
            </div>
        </div>

        <!-- Internet Connections Section -->
        <div class="space-y-4">
            <h3 class="text-xl font-bold text-foreground border-b border-border/50 pb-2">
                cool internet people
            </h3>
            <div class="grid md:grid-cols-3 gap-6 md:gap-8">
                {internetMembers.map((member) => (
                    <a href={member.websiteUrl} target="_blank" rel="noopener noreferrer" class="webring-card group">
                        <div class="rounded-none border border-border/50 hover:border-border hover:bg-background/50 transition-all duration-300 p-6 h-full flex flex-col">
                            <!-- Profile Section -->
                            <div class="flex items-center gap-3 mb-6">
                                <img
                                src={member.pfpUrl}
                                alt={member.name}
                                style="width: 50px; height: 50px;"
                                class="rounded-full object-cover"
                                />
                                <h3 class="text-2xl font-bold text-foreground group-hover:text-primary transition-colors">
                                    {member.name}
                                </h3>
                            </div>

                            <!-- Description -->
                            <p class="text-sm text-justify text-muted-foreground leading-relaxed mb-6 flex-grow">
                                {member.description}
                            </p>

                            <!-- Visit Link -->
                            <div class="mt-auto">
                                <span class="text-sm text-muted-foreground group-hover:text-primary transition-colors">
                                    visit website
                                </span>
                            </div>
                        </div>
                    </a>
                ))}
            </div>
        </div>
    </div>
</BaseLayout>

<style>
    .webring-card {
        animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }
</style>
