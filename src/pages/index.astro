---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

import ContactSection from "../components/ContactSection.svelte";
import AwardsSection from "../components/AwardsSection.svelte";
import IntroSection from "../components/IntroSection.svelte";
import ProjectsSection from "../components/ProjectsSection.svelte";
import BlogSection from "../components/BlogSection.svelte";

const posts = await getCollection("blog");
---

<BaseLayout
	title="Asandei"
	description="Personal website of Asandei Stefan-Alexandru"
>
	<main
		class="md:max-w-2xl px-2 lg:max-w-6xl mx-2 md:mx-auto flex flex-col gap-6"
	>
		<IntroSection />
		<BlogSection {posts} />
		<!-- todo: work experience, research -->
		<ProjectsSection />
		<AwardsSection />
		<ContactSection />
	</main>
</BaseLayout>
