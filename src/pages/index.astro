---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

import AwardsSection from "../components/AwardsSection.svelte";
import IntroSection from "../components/IntroSection.svelte";
import NewsSection from "../components/NewsSection.svelte";
import ResearchSection from "../components/ResearchSection.svelte";
import ProjectsSection from "../components/ProjectsSection.svelte";
import BlogSection from "../components/BlogSection.svelte";
import { getPublications } from "../lib/arxiv";
import { arxivLinks, codeLinks } from "../data/publications";

const posts = await getCollection("blog");
const projects = await getCollection("project");
const publications = await getPublications(arxivLinks, codeLinks);
---

<BaseLayout
	title="Asandei"
	description="Personal website of Asandei Stefan-Alexandru"
>
	<main
		class="md:max-w-2xl px-2 lg:max-w-6xl mx-2 md:mx-auto flex flex-col gap-8 md:gap-6"
	>
		<IntroSection />
		<NewsSection />
		<ResearchSection {publications} />
		<BlogSection {posts} />
		<ProjectsSection {projects} />
		<AwardsSection />
	</main>
</BaseLayout>
